#!/usr/bin/env bun
// tack — publish and share pages on an artifacts server (this repo's Worker).
// The smoke suite (test/smoke.ts) runs this file. Agent usage: skills/tack/SKILL.md.
// Lines on a terminal, JSON when piped. Exit 2 usage, 4 auth, 5 API.
//   TACK_URL    the server's APP_ORIGIN, e.g. https://share.example.com (required)
//   TACK_TOKEN  a token from the gallery page ("Tokens for the CLI and agents")
import { cpSync, existsSync, mkdirSync, mkdtempSync, readdirSync, readFileSync, rmSync, statSync, writeFileSync } from "node:fs";
import { createRequire } from "node:module";
import { homedir, tmpdir } from "node:os";
import { basename, join, relative } from "node:path";

const HELP = `tack <command> [args]

  publish <file.html|dir> [--id ID] [--title T] [--desc D] [--label L] [--remove PATH]... [--base N]
        New artifact, or a new version of --id. A directory needs index.html at its root.
        A new version keeps files you leave out; --remove drops one.
  board <review-id|file.whiteboard> [--id ID] [--title T] [--desc D] [--label L] [--base N]
        Publish a Whiteboard board as a read-only page. A review id is exported with the
        whiteboard CLI. The first run downloads the viewer from npm.
  board-viewer
        Admins: publish the board viewer and register it as the one this server shows shared
        Whiteboard links with (/s/...). Run again to update it.
  list                                   yours and shared with you
  get <id>                               details (sharing, when you can edit)
  share <id> [--mode private|people|org|public] [--users a@x,b@y] [--editors c@z] [--pin live|current|N]
  versions <id>
  comments <id>
  rename <id> --title T [--desc D]
  delete <id> --yes
  open <id>                              open in the browser (macOS)

env: TACK_URL (the server, e.g. https://share.example.com), TACK_TOKEN`;

const tty = process.stdout.isTTY;
const die = (code: number, msg: string): never => {
  if (tty) console.error(`tack: ${msg}`);
  else console.log(JSON.stringify({ error: msg, exit: code }));
  process.exit(code);
};

const [cmd, ...rest] = process.argv.slice(2);
if (!cmd || cmd === "-h" || cmd === "--help" || cmd === "help") {
  console.log(HELP);
  process.exit(cmd ? 0 : 2);
}

const FLAGS: Record<string, string[]> = {
  publish: ["id", "title", "desc", "label", "remove", "base"],
  board: ["id", "title", "desc", "label", "base"],
  "board-viewer": [],
  share: ["mode", "users", "editors", "pin"],
  rename: ["title", "desc"],
  delete: ["yes"],
};
const BOOL = new Set(["yes"]);
const pos: string[] = [];
const flags: Record<string, string[]> = {};
for (let i = 0; i < rest.length; i++) {
  const a = rest[i];
  if (!a.startsWith("--")) {
    pos.push(a);
    continue;
  }
  const [k, inline] = a.slice(2).split(/=(.*)/s);
  if (!(FLAGS[cmd] ?? []).includes(k)) die(2, `unknown flag --${k} for ${cmd} (tack --help)`);
  const v = BOOL.has(k) ? "1" : (inline ?? rest[++i]);
  if (v === undefined) die(2, `--${k} needs a value`);
  (flags[k] ??= []).push(v);
}
const flag = (k: string) => flags[k]?.at(-1);
const needId = () => pos[0] ?? die(2, `${cmd} needs an artifact id`);
const base = () => (process.env.TACK_URL || die(2, "TACK_URL is not set (the server, e.g. https://share.example.com)")).replace(/\/$/, "");

async function call(method: string, path: string, body?: BodyInit | object): Promise<any> {
  const server = base();
  const token = process.env.TACK_TOKEN;
  if (!token) die(4, "TACK_TOKEN is not set (create one on the gallery page)");
  const isForm = body instanceof FormData;
  let r: Response;
  try {
    r = await fetch(`${server}/api${path}`, {
      method,
      headers: { Authorization: `Bearer ${token}`, ...(body && !isForm ? { "Content-Type": "application/json" } : {}) },
      body: body === undefined ? undefined : isForm ? body : JSON.stringify(body),
    });
  } catch (e) {
    return die(5, `${server} unreachable: ${(e as Error).message}`);
  }
  const text = await r.text();
  let j: any;
  try {
    j = JSON.parse(text);
  } catch {
    j = { error: text.slice(0, 300) };
  }
  // The Whiteboard routes answer {"error":{"code"}}, the rest {"error":"message"}.
  const why = (typeof j.error === "object" ? j.error?.code : j.error) ?? `HTTP ${r.status}`;
  if (r.status === 401 || r.status === 403) die(4, why);
  if (!r.ok) die(5, why);
  return j;
}

function out(data: unknown, lines: () => string) {
  console.log(tty ? lines() : JSON.stringify(data));
}

function walk(dir: string): string[] {
  return readdirSync(dir).flatMap((n) => {
    if (n.startsWith(".") || n === "node_modules") return [];
    const p = join(dir, n);
    return statSync(p).isDirectory() ? walk(p) : [p];
  });
}

// Finishes a publish: the shared flags, then a new artifact or a new version of --id.
async function send(fd: FormData, defaultTitle: string) {
  const title = flag("title") ?? (flag("id") ? undefined : defaultTitle);
  if (title) fd.append("title", title);
  if (flag("desc")) fd.append("description", flag("desc")!);
  if (flag("label")) fd.append("label", flag("label")!);
  if (flag("base")) fd.append("base_version", flag("base")!);
  const a = flag("id") ? await call("POST", `/artifacts/${flag("id")}/versions`, fd) : await call("POST", "/artifacts", fd);
  out(a, () => `${a.url}\n  ${a.title} · v${a.live_version} · ${sharingLine(a)}`);
}

// Whiteboard's snapshot format, and the viewer that reads it: @dev.fast/canvas (MIT) with React.
// Both are fetched from npm once per version into a cache and published as static files, so a
// board page loads nothing from outside its own origin.
const BOARD_FORMAT = "review-share/2";
const CANVAS_VERSION = "0.5.0";
const REACT_VERSION = "19.2.9";
const REACT_ENTRIES: [string, string][] = [
  ["react", "react"],
  ["react/jsx-runtime", "jsx-runtime"],
  ["react-dom", "react-dom"],
  ["react-dom/client", "react-dom-client"],
];

async function boardViewer(): Promise<string> {
  const cache = join(process.env.XDG_CACHE_HOME || join(homedir(), ".cache"), "tack", `board-viewer-canvas${CANVAS_VERSION}-react${REACT_VERSION}`);
  const site = join(cache, "site");
  if (existsSync(join(cache, "ready"))) return site;
  if (tty) console.error("tack: fetching the board viewer from npm (first run only)");
  rmSync(cache, { recursive: true, force: true });
  mkdirSync(join(cache, "shim"), { recursive: true });
  writeFileSync(join(cache, "package.json"), JSON.stringify({ name: "tack-board-viewer", private: true }));
  const add = Bun.spawnSync(
    [process.execPath, "add", "--exact", `@dev.fast/canvas@${CANVAS_VERSION}`, `react@${REACT_VERSION}`, `react-dom@${REACT_VERSION}`],
    { cwd: cache, stdout: "pipe", stderr: "pipe" },
  );
  if (add.exitCode !== 0) die(5, `could not fetch the board viewer from npm: ${add.stderr.toString().trim().split("\n").at(-1)}`);
  // React ships CommonJS; the canvas imports it by name. One ES module per entry, sharing chunks,
  // so the page's import map resolves every import to the same React.
  const req = createRequire(join(cache, "package.json"));
  for (const [name, file] of REACT_ENTRIES) {
    const names = Object.keys(req(name)).filter((k) => k !== "default" && /^[A-Za-z_$][\w$]*$/.test(k));
    writeFileSync(join(cache, "shim", `${file}.js`), `import M from "${name}";\nexport default M;\nexport const { ${names.join(", ")} } = M;\n`);
  }
  const built = await Bun.build({
    entrypoints: REACT_ENTRIES.map(([, file]) => join(cache, "shim", `${file}.js`)),
    outdir: join(site, "vendor"),
    format: "esm",
    splitting: true,
    minify: true,
    target: "browser",
    define: { "process.env.NODE_ENV": '"production"' },
  });
  if (!built.success) die(5, `could not build the board viewer: ${built.logs.map(String).join("; ")}`);
  cpSync(join(cache, "node_modules", "@dev.fast", "canvas", "dist"), join(site, "canvas"), { recursive: true });
  rmSync(join(site, "canvas", "index.d.ts"), { force: true });
  writeFileSync(join(cache, "ready"), "");
  return site;
}

const MODE: Record<string, string> = { private: "owner", people: "users", org: "org", public: "public" };
const LABEL: Record<string, string> = { owner: "only you", users: "specific people", org: "the org", public: "anyone with the link" };
const sharingLine = (a: any) =>
  a.sharing
    ? `${LABEL[a.sharing.mode]}${a.sharing.users.length ? ` (${a.sharing.users.join(", ")})` : ""}; viewers see ${a.sharing.viewers_see}${a.sharing.pinned_version ? ` v${a.sharing.pinned_version}` : ""}${a.sharing.editors.length ? `; editors ${a.sharing.editors.join(", ")}` : ""}`
    : a.role;

// The viewer's files as publish parts: the npm build, then the page that drives it.
async function boardViewerFiles(): Promise<FormData> {
  const fd = new FormData();
  for (const root of [await boardViewer(), join(import.meta.dir, "board-viewer")])
    for (const f of walk(root)) fd.append("file", new Blob([readFileSync(f)]), relative(root, f).split("\\").join("/"));
  return fd;
}

switch (cmd) {
  case "publish": {
    const src = pos[0] ?? die(2, "publish needs a file or directory");
    let st;
    try {
      st = statSync(src);
    } catch {
      die(2, `${src}: no such file or directory`);
    }
    const fd = new FormData();
    if (st!.isDirectory()) {
      const files = walk(src);
      if (!files.some((f) => relative(src, f) === "index.html") && !flag("id")) die(2, `${src} has no index.html`);
      for (const f of files) fd.append("file", new Blob([readFileSync(f)]), relative(src, f).split("\\").join("/"));
    } else {
      fd.append("file", new Blob([readFileSync(src)]), "index.html");
    }
    for (const r of flags.remove ?? []) fd.append("remove", r);
    await send(fd, basename(src).replace(/\.html?$/, ""));
    break;
  }
  case "board": {
    const src = pos[0] ?? die(2, "board needs a review id or a .whiteboard file");
    let raw: Buffer;
    if (existsSync(src) && statSync(src).isFile()) {
      raw = readFileSync(src);
    } else {
      const tmp = mkdtempSync(join(tmpdir(), "tack-board-"));
      const file = join(tmp, "board.whiteboard");
      let r;
      try {
        r = Bun.spawnSync(["whiteboard", "export", "--review", src, "--out", file], { stdout: "pipe", stderr: "pipe" });
      } catch {
        die(2, `${src} is not a file, and the whiteboard CLI that would export a review is not on PATH`);
      }
      if (r!.exitCode !== 0 || !existsSync(file)) {
        rmSync(tmp, { recursive: true, force: true });
        die(2, `whiteboard export --review ${src} failed: ${r!.stderr.toString().trim().split("\n").at(-1) || `exit ${r!.exitCode}`}`);
      }
      raw = readFileSync(file);
      rmSync(tmp, { recursive: true, force: true });
    }
    let bundle: any;
    try {
      bundle = JSON.parse(raw.toString());
    } catch {
      bundle = null;
    }
    if (bundle?.format !== BOARD_FORMAT) die(2, `${src} is not a Whiteboard snapshot (${BOARD_FORMAT})`);
    const fd = await boardViewerFiles();
    fd.append("file", new Blob([raw]), "board.whiteboard");
    flags.label ??= [`board v${bundle.version}`];
    await send(fd, String(bundle.title ?? "Whiteboard"));
    break;
  }
  case "board-viewer": {
    // The viewer with no board beside it: a share's page gets its board.whiteboard from the server.
    // Checked first, so someone who can't register it doesn't publish a stray copy.
    const me = await call("GET", "/me");
    if (!me.admin) die(4, "only an admin registers the board viewer");
    const fd = await boardViewerFiles();
    fd.append("label", `canvas ${CANVAS_VERSION}`);
    // Update the registered viewer when it is yours; an admin registers only their own artifact.
    const registered = await call("GET", "/whiteboard/viewer");
    const current: string | null = registered.owner === me.email ? registered.artifact : null;
    if (!current) fd.append("title", "Whiteboard board viewer");
    const a = current ? await call("POST", `/artifacts/${current}/versions`, fd) : await call("POST", "/artifacts", fd);
    await call("PUT", "/whiteboard/viewer", { artifact: a.id });
    out({ ...a, registered: true }, () => `${a.url}\n  ${a.title} · v${a.live_version} · registered at this version as this server's board viewer`);
    break;
  }
  case "list": {
    const { artifacts } = await call("GET", "/artifacts");
    out(artifacts, () =>
      artifacts.length ? artifacts.map((a: any) => `${a.id}  v${a.live_version}  ${a.title}  [${a.sharing ? LABEL[a.sharing.mode] : a.role}]`).join("\n") : "(none)",
    );
    break;
  }
  case "get": {
    const a = await call("GET", `/artifacts/${needId()}`);
    out(a, () => `${a.url}\n  ${a.title} · v${a.live_version} · owner ${a.owner}\n  ${sharingLine(a)}`);
    break;
  }
  case "share": {
    const body: Record<string, unknown> = {};
    const m = flag("mode");
    if (m) body.mode = MODE[m] ?? die(2, "--mode is private, people, org or public");
    if (flag("users") !== undefined) body.users = flag("users");
    if (flag("editors") !== undefined) body.editors = flag("editors");
    const pin = flag("pin");
    if (pin) body.pin = /^\d+$/.test(pin) ? Number(pin) : pin;
    if (!Object.keys(body).length) die(2, "share needs --mode, --users, --editors or --pin");
    const a = await call("PUT", `/artifacts/${needId()}/sharing`, body);
    out(a, () => `${a.url}\n  ${sharingLine(a)}`);
    break;
  }
  case "versions": {
    const { versions } = await call("GET", `/artifacts/${needId()}/versions`);
    out(versions, () => versions.map((v: any) => `v${v.ver}  ${v.created_at}  ${v.author}  ${v.files} files  ${v.label}`).join("\n"));
    break;
  }
  case "comments": {
    const { comments } = await call("GET", `/artifacts/${needId()}/comments`);
    out(comments, () =>
      comments.length ? comments.map((c: any) => `${c.resolved ? "✓" : "•"} ${c.author} (v${c.ver}, ${c.created_at}): ${c.body}`).join("\n") : "(no comments)",
    );
    break;
  }
  case "rename": {
    const title = flag("title") ?? die(2, "rename needs --title");
    const a = await call("PATCH", `/artifacts/${needId()}`, { title, ...(flag("desc") !== undefined ? { description: flag("desc") } : {}) });
    out(a, () => `${a.url}\n  ${a.title}`);
    break;
  }
  case "delete": {
    const id = needId();
    if (!flag("yes")) die(2, `delete is permanent; rerun with --yes to delete ${id}`);
    const r = await call("DELETE", `/artifacts/${id}`);
    out(r, () => `deleted ${id}`);
    break;
  }
  case "open": {
    const url = `${base()}/a/${needId()}`;
    Bun.spawnSync(["open", url]);
    out({ url }, () => url);
    break;
  }
  default:
    die(2, `unknown command ${cmd} (tack --help)`);
}
